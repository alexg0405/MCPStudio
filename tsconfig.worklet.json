{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worklet.tsbuildinfo",
    "lib": [
      "ES2023"
    ],
    "types": [
      "audioworklet"
    ]
  },
  "include": [
    "src/**/*.worklet.ts",
    "plugins/**/*.worklet.ts",
    "templates/**/*.worklet.ts",
    "src/sdk/worklet",
    "src/sdk/dsp",
    "src/sdk/params.ts",
    "src/sdk/protocol.ts",
    "test/**/*.worklet.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
