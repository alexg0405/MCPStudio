#!/bin/sh
# One command to start AGstudio on macOS and Linux: `agstudio` (linked into ~/.local/bin). It only finds Node and
# runs scripts/agstudio.mjs, where the real work is (see the top of that file for what `agstudio` and `agstudio --app` do).
# Windows uses bin/agstudio.cmd, which does the same.
#
# The repo this script lives in, following the ~/.local/bin link.
src="$0"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
repo="$(cd -P "$(dirname "$src")/.." && pwd)"

# Node 22: in ~/.local/node (where it lives on the owner's Mac, not on the PATH), on the PATH, or where Homebrew
# and the installer from nodejs.org put it.
for node in "$HOME/.local/node/bin/node" "$(command -v node 2>/dev/null)" /opt/homebrew/bin/node /usr/local/bin/node; do
  if [ -n "$node" ] && [ -x "$node" ]; then exec "$node" "$repo/scripts/agstudio.mjs" "$@"; fi
done
echo "agstudio: Node.js was not found. Install Node 22 or newer from https://nodejs.org, then open a new terminal." >&2
exit 1
