# Copy to .env.local (which git ignores) and fill in to let the beat assistant use Claude.
# Get a key at https://console.anthropic.com/ — it stays on your machine: the dev server adds it to
# requests, the browser page never sees it. Changes apply on the next request (no restart).
ANTHROPIC_API_KEY=

# Optional: where the Codex command is, if the ChatGPT app / `npm i -g @openai/codex` put it somewhere unusual
# (ChatGPT backend: your ChatGPT plan through `codex login`; no key needed).
# AGSTUDIO_CODEX_BIN=/path/to/codex
# Windows example: AGSTUDIO_CODEX_BIN=C:\Users\you\AppData\Roaming\npm\codex.cmd

# Optional: where Claude Code is, if AGstudio cannot find it (Claude subscription backend; sign in once with `claude auth login`).
# AGSTUDIO_CLAUDE_BIN=/path/to/claude
# Windows example: AGSTUDIO_CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
